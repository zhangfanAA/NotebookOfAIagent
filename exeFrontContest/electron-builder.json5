{
  appId: "com.learning-assistant.exefront",
  productName: "智能学习助手",
  directories: {
    output: "release",
    buildResources: "resources"
  },
  files: [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  win: {
    target: ["nsis"],
    icon: "resources/icon.png"
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    createDesktopShortcut: true
  }
}
