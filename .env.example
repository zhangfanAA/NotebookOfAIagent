# ============================================
# 环境变量模板 — 复制为 .env 后填写
# ============================================

# DeepSeek API（云端 LLM，支持 tool calling）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Ollama（本地 LLM，Docker 中通过 host.docker.internal 访问宿主机）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# MySQL（Docker 内部使用 mysql 容器名，本地开发用 localhost）
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
DB_PASSWORD=1234
DB_NAME=project

# JWT 密钥（生产环境必须修改）
JWT_SECRET=your-secret-key-here

# 应用
# APP_HOST=0.0.0.0
# APP_PORT=8000

# 前端端口
# FRONTEND_PORT=3000
